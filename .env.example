# Скопируйте в .env и поменяйте значения перед запуском.

# Окружение: development | production
APP_ENV=development

# Секрет подписи JWT: не короче 32 символов, в проде — случайный.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-please-32-chars
JWT_TTL=168h

# Подключение к PostgreSQL
DATABASE_URL=postgres://rental:rental@localhost:5432/rental?sslmode=disable

# HTTP
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173

# Файлы документов и собранный фронтенд
FILES_DIR=./data/files
WEB_DIR=./web
RUN_MIGRATIONS=true

# Docker Compose (только для контейнеров)
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental
POSTGRES_PORT=5432
API_PORT=8080
